# Knowledge base JSON (from scripts/preprocess.py)
MMD_PATH=./output/knowledge_base.json
# 向量编码设备：auto（有 GPU 用 cuda）| cuda | cuda:0 | cpu
# FINANCE_EMBED_DEVICE=cuda
# FINANCE_EMBED_BATCH_SIZE=64

# Local causal LM for answers (default in code: F:/Tools/money_tools/models/deepseek-r1-1.5b)
# FINANCE_GEN_MODEL=F:/Tools/money_tools/models/deepseek-r1-1.5b
# 逐题推理阶段：CUDA 不稳定或 python.exe 弹窗崩溃时，可强制 CPU
# FINANCE_GEN_DEVICE=cpu
# FINANCE_GEN_FP32=1

# Image backend: colpali | visrag
IMAGE_BACKEND=visrag

# Graph fusion; without Neo4j uses output/kg_triples.json if present
ENABLE_GRAPH=false

# Optional Neo4j
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password

# ---- 企业平台（python -m app.main）----
# Local development is the default. For Compose, set APP_ENV=production and
# generate independent random JWT_SECRET and BOOTSTRAP_ADMIN_PASSWORD values.
# APP_ENV=development
# FINANCE_WEB_DEMO=1
# FINANCE_MAX_BLOCKS=8000
# FINANCE_SKIP_IMAGE=1
# MEM_WARN_PCT=70
# MEM_SOFT_PCT=85
# MEM_HARD_PCT=92
# MAX_CONCURRENT_INFER=1
# GEN_IDLE_UNLOAD_SEC=600
# JWT_SECRET=<random value of at least 32 characters>
# BOOTSTRAP_ADMIN_USER=admin
# BOOTSTRAP_ADMIN_PASSWORD=<different random value of at least 12 characters>
# HOST=127.0.0.1
# PORT=8000
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# DATABASE_URL=sqlite:////app/data_runtime/data_app.db
# API_BIND_HOST=127.0.0.1

# ---- DeepSeek API 生成（推荐小内存机器）----
# FINANCE_GEN_BACKEND=api
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_DISABLE_THINKING=1
# FINANCE_SKIP_GEN=0
# FINANCE_RERANK_BACKEND=hybrid
# FINANCE_API_RERANK_CANDIDATES=12

# Optional real public-web search. Requires an active Tavily key; never paste
# a placeholder into a running .env. Search sends only the user's question.
# TAVILY_API_KEY=tvly-your-active-key
# FINANCE_WEB_ALLOWED_DOMAINS=pbc.gov.cn
# Production keeps Web search disabled unless an explicit domain list is set.

# Optional evidence-bound LLM KG subset. Keep off until the pilot checkpoint
# has been reviewed; it does not represent full-corpus graph coverage.
# FINANCE_KG_PILOT_ENABLED=0
